<?xml version="1.0" encoding="UTF-8"?>
<!-- HTE (2026-10-16): the HTE test suite (upstream ships none). SQLite in memory. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true">
    <testsuites>
        <testsuite name="Hte"><directory>tests/Hte</directory></testsuite>
    </testsuites>
    <source><include><directory>app/Hte</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="CORTENDESK_SERVER_SECRET" value="test-link-secret"/>
        <env name="CORTENDESK_UPDATE_CHECK" value="false"/>
    </php>
</phpunit>
